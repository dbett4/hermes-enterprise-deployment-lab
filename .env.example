# Local lab fixture values — not production secrets.
# Copy to .env for local/Podman Compose runs: cp .env.example .env

# Read scope: incident and runbook GETs.
ENTERPRISE_API_TOKEN=lab-read-token
# Write scope: applying a runbook action. Deliberately a different value so a
# read-only credential provably cannot mutate.
ENTERPRISE_API_WRITE_TOKEN=lab-write-token
ENTERPRISE_API_URL=http://enterprise-api:8080
DEFAULT_INCIDENT_ID=INC-2026-0042

# Optional loopback host ports for manual Compose use. The container proof
# chooses free ports and an isolated Compose project automatically.
# ENTERPRISE_API_PORT=8080
# PROMETHEUS_PORT=9090

# Optional: persist applied actions across enterprise-api restarts (Compose sets
# this to a volume path). Leave unset for the default in-memory store.
# ACTION_STORE_PATH=/var/lib/enterprise-api/actions.json

# MCP tool surface. Unset/omitted means read+plan only; the mutating tool is
# opt-in. Use "all" to expose apply_incident_plan.
# ENTERPRISE_MCP_ENABLED_TOOLS=all

# Deterministic fault switch for the MCP server: error | error_after_commit | timeout
# ENTERPRISE_INJECT_FAILURE=error_after_commit

# Approval request/capability lifetime in seconds (default: 900).
# APPROVAL_TTL_SECONDS=900
